# Plantilla del entorno de STAGING (rama `staging` de Neon). Copiar a `.env.staging` (NO se versiona) y llenar ahí.
# Nunca pongas aquí valores reales: este archivo sí está en el repo público.

# --- Base de datos: rama `staging` de Neon, rol golden_app ---
# Cadena "pooled" (host con -pooler): la usa la app.
DATABASE_URL=
# Cadena directa (host sin -pooler): la usan las migraciones (alembic) y pg_dump.
DIRECT_DATABASE_URL=

# production también en staging (cookie Secure, /docs cerrado). Para probar el contenedor en http://localhost usa development.
ENVIRONMENT=production
# Nombre del entorno (staging | production). Los scripts de datos de prueba exigen staging.
DEPLOY_ENV=staging
# Aleatoria y distinta de producción: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Llave NUEVA solo para staging (python scripts/gen_face_key.py). Nunca la de producción.
FACE_ENCRYPTION_KEY=
PUBLIC_BASE_URL=

# --- Archivos: vacío = carpeta local del contenedor; en Cloud Run: gcs + bucket de staging ---
STORAGE_BACKEND=
GCS_BUCKET=
GCS_PREFIX=

# --- Cola: vacío = hilo local; en Cloud Run: cloudtasks ---
JOBS_BACKEND=
CLOUD_TASKS_QUEUE=
CLOUD_TASKS_URL=
JOBS_INVOKER_SA=
OPS_TOKEN=

# --- Pagos: SOLO llaves de pruebas de Wompi (pub_test_...) en staging ---
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_PRIVATE_KEY=

# --- Correo: vacío = los correos quedan en outbox/ del almacenamiento y no sale nada ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GRAPH_SENDER=
