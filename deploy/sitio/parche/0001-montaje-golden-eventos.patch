+// robots.txt generado al compilar. Producción (PUBLIC_INDEXAR=1) permite todo y anuncia el sitemap; cualquier otra compilación
+// (vista previa, equipo local) pide no indexar. Misma regla que el <meta name="robots"> de src/layouts/Base.astro.
+import type { APIRoute } from 'astro';
+
+export const GET: APIRoute = ({ site }) => {
+  const base = site ?? new URL('https://golden-eventos.com');
+  const cuerpo = import.meta.env.PUBLIC_INDEXAR === '1'
+    ? `User-agent: *\nAllow: /\n\nSitemap: ${new URL('/sitemap.xml', base).href}\n`
+    : 'User-agent: *\nDisallow: /\n';
+  return new Response(cuerpo, { headers: { 'Content-Type': 'text/plain; charset=utf-8' } });
+};
