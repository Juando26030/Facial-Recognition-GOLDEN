diff --git a/src/layouts/Legal.astro b/src/layouts/Legal.astro
new file mode 100644
index 0000000..2565c2b
--- /dev/null
+++ b/src/layouts/Legal.astro
@@ -0,0 +1,53 @@
+---
+// Página de texto largo (políticas, avisos): cabecera fija a la izquierda y secciones numeradas a la derecha.
+// Mismo aspecto que src/pages/terminos.astro. Cada sección: { t: título, x: párrafos y/o listas }.
+import Base from './Base.astro';
+
+export interface Parrafo { texto?: string; lista?: string[]; html?: string }
+export interface Seccion { t: string; x: Parrafo[]; id?: string }
+interface Props { titulo: string; descripcion: string; kicker: string; h1: string; aviso?: string; secciones: Seccion[]; noindex?: boolean }
+const { titulo, descripcion, kicker, h1, aviso, secciones, noindex = false } = Astro.props;
+---
+<Base titulo={titulo} descripcion={descripcion} noindex={noindex}>
+  <section class="legal">
+    <div class="contenedor legal__in">
+      <div class="legal__cabeza">
+        <p class="kicker" data-reveal>{kicker}</p>
+        <h1 class="titulo-xl" data-reveal data-titulo style="--d:80ms">{h1}</h1>
+        {aviso && <p class="legal__aviso" data-reveal style="--d:140ms">{aviso}</p>}
+        <slot name="cabeza" />
+      </div>
+      <ol class="legal__lista">
+        {secciones.map((s) => (
+          <li data-reveal id={s.id}>
+            <h2>{s.t}</h2>
+            {s.x.map((p) => (
+              <>
+                {p.texto && <p>{p.texto}</p>}
+                {p.html && <p set:html={p.html} />}
+                {p.lista && <ul>{p.lista.map((i) => <li set:html={i} />)}</ul>}
+              </>
+            ))}
+          </li>
+        ))}
+      </ol>
+    </div>
+    <slot />
+  </section>
+</Base>
+
+<style>
+  .legal { padding-top: clamp(8rem, 20vh, 12rem); padding-bottom: var(--seccion); }
+  .legal__in { display: grid; grid-template-columns: 1fr 1.6fr; gap: clamp(2rem, 6vw, 7rem); align-items: start; }
+  .legal__cabeza { position: sticky; top: 120px; display: grid; gap: 1.5rem; }
+  .legal__aviso { color: var(--tinta-suave); font-size: var(--t-s); line-height: 1.5; max-width: 40ch; padding: 1rem 1.25rem; border: 1.5px dashed color-mix(in srgb, currentColor 45%, transparent); border-radius: 14px; }
+  .legal__lista { list-style: none; padding: 0; counter-reset: n; border-bottom: 1px solid var(--linea); }
+  .legal__lista li { counter-increment: n; border-top: 1px solid var(--linea); padding-block: 1.75rem; display: grid; gap: .6rem; }
+  .legal__lista h2 { font: 400 var(--t-m)/1.25 var(--f-display); letter-spacing: -.015em; }
+  .legal__lista h2::before { content: counter(n, decimal-leading-zero); font: 400 var(--t-s)/1 var(--f-narrow); letter-spacing: .1em; color: var(--miel-texto); margin-right: 1rem; }
+  .legal__lista p, .legal__lista ul { color: var(--tinta-suave); max-width: 64ch; }
+  .legal__lista ul { padding-left: 1.25rem; display: grid; gap: .45rem; }
+  .legal__lista ul li { counter-increment: none; border: 0; padding: 0; display: list-item; }
+  .legal__lista :global(a) { color: var(--tinta); background: linear-gradient(currentColor, currentColor) 0 100% / 100% 1px no-repeat; }
+  @media (max-width: 860px) { .legal__in { grid-template-columns: 1fr; } .legal__cabeza { position: static; } }
+</style>
