+---
+// Página «no encontrada». Firebase Hosting sirve dist/404.html para cualquier dirección que no exista.
+import Base from '../layouts/Base.astro';
+import Flecha from '../components/Flecha.astro';
+import sitio from '../data/sitio.json';
+---
+<Base titulo="Página no encontrada · Golden Eventos y Logística" descripcion="La página que busca no existe o cambió de dirección." noindex>
+  <section class="nada">
+    <div class="contenedor nada__in">
+      <p class="kicker">Error 404</p>
+      <h1 class="titulo-xl">Esta página no existe.</h1>
+      <p class="nada__texto">Puede que la dirección haya cambiado. Desde el inicio encuentra todo lo que hacemos.</p>
+      <div class="nada__acciones">
+        <a href="/" class="btn btn--grande">Ir al inicio<Flecha /></a>
+        <a href={sitio.cta.url} class="enlace">{sitio.cta.texto}<Flecha /></a>
+      </div>
+    </div>
+  </section>
+</Base>
+
+<style>
+  .nada { padding-top: clamp(8rem, 20vh, 12rem); padding-bottom: var(--seccion); min-height: 70svh; }
+  .nada__in { display: grid; gap: 1.5rem; justify-items: start; }
+  .nada__texto { font-size: var(--t-m); color: var(--tinta-suave); max-width: 40ch; }
+  .nada__acciones { display: flex; align-items: center; gap: 2rem; flex-wrap: wrap; margin-top: 1rem; }
+</style>
