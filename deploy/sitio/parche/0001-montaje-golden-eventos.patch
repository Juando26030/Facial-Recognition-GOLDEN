+  { t: 'Lo que no hacemos con IA', x: [{ texto: 'No tomamos decisiones automatizadas con efectos legales sobre usted (precios, admisión, sanciones) sin intervención humana. No usamos sus datos para entrenar modelos de IA.' }] },
