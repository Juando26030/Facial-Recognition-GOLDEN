+// sitemap.xml generado al compilar a partir de las páginas que existan en src/pages (una página nueva entra sola).
+// No entran: 404, páginas dinámicas ([..]), archivos que empiezan por «_» y, mientras sitio.json → legal.borrador sea true, los borradores legales.
+import type { APIRoute } from 'astro';
+import sitio from '../data/sitio.json';
+
+const paginas = import.meta.glob('./**/*.astro');
+
+export const GET: APIRoute = ({ site }) => {
+  const base = site ?? new URL('https://golden-eventos.com');
+  const fuera = new Set(['/404', ...(sitio.legal.borrador ? [sitio.privacidad, sitio.inteligenciaArtificial] : [])]);
+  const rutas = Object.keys(paginas)
+    .map((k) => k.replace(/^\.\//, '/').replace(/\.astro$/, '').replace(/\/index$/, '') || '/')
+    .filter((r) => !fuera.has(r) && !r.includes('[') && !r.split('/').some((p) => p.startsWith('_')))
+    .sort();
+  const urls = rutas.map((r) => `  <url><loc>${new URL(r, base).href}</loc></url>`).join('\n');
+  const xml = `<?xml version="1.0" encoding="UTF-8"?>\n<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n${urls}\n</urlset>\n`;
+  return new Response(xml, { headers: { 'Content-Type': 'application/xml; charset=utf-8' } });
+};
