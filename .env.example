DATABASE_URL=postgresql://usuario:password@localhost:5432/golden_db

# development (default) deja /docs, /redoc, /openapi.json abiertos y la cookie de sesión sin flag Secure.
# En producción, poner ENVIRONMENT=production (obligatorio junto con SECRET_KEY).
ENVIRONMENT=development

# Secreto para firmar la cookie de sesión. Generar uno único por entorno, ej:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-un-valor-aleatorio-largo

# Correo saliente (informe final del evento -> comercial; escarapela digital por correo).
#
# CAMINO RECOMENDADO para Microsoft 365 corporativo: Microsoft Graph API vía OAuth2 (client credentials),
# no SMTP AUTH ni contraseñas de aplicación — Microsoft las está retirando globalmente. Pasos (los haces
# tú, con un administrador de Entra ID/M365 — Claude no puede tocar configuración de cuentas):
#   1. entra.microsoft.com (o portal.azure.com) -> Identidad -> Aplicaciones -> Registros de aplicaciones
#      -> Nuevo registro. Nombre libre (ej. "Golden Eventos - Envío de correo"), tipo "Solo este directorio
#      organizativo" (single tenant). Crear.
#   2. En la app creada: "Permisos de API" -> Agregar un permiso -> Microsoft Graph -> Permisos de
#      APLICACIÓN (no delegados) -> buscar y marcar "Mail.Send" -> Agregar permisos -> luego el botón
#      "Conceder consentimiento de administrador para <tu organización>" (necesita un admin global o de
#      aplicaciones — sin este paso el token se emite pero Graph rechaza el envío).
#   3. "Certificados y secretos" -> Nuevo secreto de cliente -> copiar el VALOR inmediatamente (solo se
#      muestra una vez) -> eso es AZURE_CLIENT_SECRET.
#   4. En "Información general" de la app: copiar "Id. de aplicación (cliente)" (AZURE_CLIENT_ID) e
#      "Id. de directorio (inquilino)" (AZURE_TENANT_ID).
#   5. GRAPH_SENDER = el buzón que va a figurar como remitente (ej. soporteit@goldenlogisticas.com) — no
#      necesita contraseña propia, el permiso Mail.Send de la app ya autoriza a enviar EN NOMBRE de
#      cualquier buzón del tenant. Recomendado (opcional, refuerzo de seguridad): restringir la app a
#      enviar solo desde ese buzón con una ApplicationAccessPolicy en Exchange Online PowerShell
#      (`New-ApplicationAccessPolicy -AppId <client-id> -PolicyScopeGroupId <grupo-con-ese-buzón>
#      -AccessRight RestrictAccess`) — si no se hace, la app puede enviar como cualquier buzón del tenant.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GRAPH_SENDER=soporteit@goldenlogisticas.com

# Alternativa/fallback si no se usa Graph (cualquier otro proveedor SMTP, o M365 con SMTP AUTH ya
# habilitado a mano) — solo se usa si las 4 variables de Graph de arriba NO están todas puestas.
# SMTP_HOST=smtp.tu-proveedor.com
# SMTP_PORT=587
# SMTP_USER=notificaciones@tudominio.com
# SMTP_PASSWORD=...
# SMTP_FROM=Golden Eventos <notificaciones@tudominio.com>
# SMTP_TLS=true
#
# Sin Graph NI SMTP configurados, el correo no se envía: se guarda como .eml en data/outbox/ (útil en desarrollo).

# Escarapela digital (ítem 17): dominio público con el que se arma el enlace /b/<token> — por defecto usa
# el dominio de la petición, pero para que el enlace enviado por correo/WhatsApp sea siempre el mismo
# (aunque se pruebe desde otra URL), fijarlo explícito. Ese dominio/subdominio debe apuntar (DNS) a la
# misma VM de producción y estar en el certificado TLS (Certbot) y en el server_name de Nginx.
# PUBLIC_BASE_URL=https://golden.juandajuzga.com

# WhatsApp (envío de la escarapela digital cuando el contacto es un celular) vía WhatsApp Cloud API de
# Meta — NO por SMS/Twilio. Necesita: una cuenta de WhatsApp Business (WABA) en Meta Business Manager, un
# número dedicado registrado en el Cloud API (no puede estar activo en la app normal de WhatsApp), y una
# PLANTILLA de mensaje aprobada por Meta (ver el comentario junto a `_send_whatsapp` en app/digital_badge.py
# para el texto sugerido) — sin plantilla aprobada, Meta rechaza cualquier mensaje que la empresa inicia.
# WHATSAPP_TOKEN=...            # token permanente de un System User (no el de prueba de 24h)
# WHATSAPP_PHONE_NUMBER_ID=...  # "Phone number ID" del panel de WhatsApp > Introducción
# WHATSAPP_TEMPLATE_NAME=escarapela_digital
# WHATSAPP_TEMPLATE_LANG=es

# Zona horaria de los reportes de Áreas/Inventario/Legalizaciones (por defecto America/Bogota).
# APP_TIMEZONE=America/Bogota
